APP_NAME=RAGForge
ENVIRONMENT=development
DEBUG=false

POSTGRES_DB=ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+asyncpg://ragforge:change_me_local_only@postgres:5432/ragforge

CHROMA_HOST=chroma
CHROMA_PORT=8000

MAX_PDF_PAGES=100
UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION=ragforge_documents

LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=/app/logs
LOG_FILE_PREFIX=ragforge
LOG_BACKUP_DAYS=14

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=700
RAG_MAX_CONTEXT_CHARS=12000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragforge-development

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60