APP_NAME="RAGForge Test"
ENVIRONMENT=test
DEBUG=false

DATABASE_URL=postgresql+asyncpg://ragforge:change_me_local_only@postgres:5432/ragforge_test

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=ragforge_test_documents

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/tmp/ragforge-test-uploads

MAX_UPLOAD_BYTES=1048576
CHUNK_SIZE=800
CHUNK_OVERLAP=120

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=WARNING
LOG_TO_FILE=true
LOG_DIR=/app/logs
LOG_FILE_PREFIX=ragforge
LOG_BACKUP_DAYS=14

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

JWT_SECRET=ragforge-test-only-secret-not-for-production-123456
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60